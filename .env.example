# Typical fare range percentage (0.15 = +/-15%)
FARE_TYPICAL_RANGE_PERCENT="0.15"

# Community stats cache duration in minutes
STATS_CACHE_DURATION_MINUTES="10"

# Rate limiting
MAX_REPORTS_PER_DAY="10"
DUPLICATE_WINDOW_MINUTES="10"
